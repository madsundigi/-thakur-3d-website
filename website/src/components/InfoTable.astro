---
// Info table — a generic real <table> in the PriceMatrix wrapper (TableFrame.astro: 08-DESIGN-SYSTEM §4.8 scroll +
// fade + sticky first column + header row + zebra; zero JS). Two modes:
//  · plain   — caption + columns + rows + optional footnotes. The blueprints' H3 tables: "Grooming by breed"
//              (dog-grooming SP-4), "Persian & long-hair coat care" (cat SP-4), walk windows (dog-walking SP-4),
//              "What a home visit can — and can't — do" (vet SP-3, rowHeaders={false}), Groom Club maths, …
//  · package — `table` = a C1 PACKAGE_TABLES entry (template SP-3 "What's-included package table", pricing PR-4):
//              ✓/— grid per package, the durations as a final "Typical duration" row (06 §5.5), the footnotes under
//              the table, and the featured column (pricing.json badge — "Most booked") in sand with its badge.
// Booleans render a ✓ (Lucide check — Inter's Latin subset has no U+2713, so a font glyph would fall back to a
// different face per phone) or an em dash, each with sr-only "Included" / "Not included". ₹ figures inside string
// cells are set in price type (08 §2.2) — pass them only from src/lib/pricing.ts helpers. The section heading (H2/H3)
// belongs to the page; footnotes come from `footnotes` and/or the default slot (rendered under them).
import TableFrame from './TableFrame.astro';
import Icon from './icons/Icon.astro';
import { getService, priceParts } from '../lib/pricing';

type Cell = string | boolean;
interface Column {
  label: string;
  /** Second header line (small, regular weight), e.g. a note or a price from the pricing helpers. */
  sub?: string;
  /** Pill under the label. Amber — only "Most booked" (08 §1.4 rule 1). */
  badge?: string;
  /** Hero-service emphasis: this column's cells sand (08 §4.8). */
  featured?: boolean;
}
interface Row { label: string; cells: readonly Cell[] }
/** Contract C1 (src/data/services.ts PACKAGE_TABLES entry, data agent). */
interface PackageTable {
  caption: string;
  columns: readonly { serviceId: string; label: string; note?: string }[];
  rows: readonly { label: string; cells: readonly Cell[] }[];
  durations?: readonly string[];
  footnotes: readonly string[];
}
type ColumnText = Readonly<Record<string, string>> | readonly (string | undefined)[];

interface Props {
  /** Table caption — sr-only unless showCaption (the page's heading names the table visually). Package mode
   *  defaults to table.caption. */
  caption?: string;
  showCaption?: boolean;
  /** Header of the first (row-label) column, e.g. 'Breed', 'Months'. Package mode default: 'Included' (SP-3). */
  rowHeader?: string;
  /** Plain mode: the data columns (the row-label column is `rowHeader`). */
  columns?: readonly Column[];
  /** Plain mode: one entry per row; `cells` align with `columns`. */
  rows?: readonly Row[];
  /** Row labels are <th scope="row"> and the first column is sticky (default). false = the first column is ordinary
   *  data (e.g. two side-by-side lists) — no row headers, nothing sticky. */
  rowHeaders?: boolean;
  /** Lines under the table (small, slate). The default slot renders after them (e.g. a line with a link). */
  footnotes?: readonly string[];
  /** Package mode: a C1 PACKAGE_TABLES entry. */
  table?: PackageTable;
  /** Package mode: header label overrides — by serviceId ({ 'premium-spa': 'Premium Spa (dog spa at home)' }) or by
   *  column position (array). */
  columnLabels?: ColumnText;
  /** Package mode: header note overrides (second line), same keys — e.g. PR-4's Full Groom note. */
  columnNotes?: ColumnText;
  /** Package mode: label of the durations row (default 'Typical duration', template SP-3). */
  durationLabel?: string;
  /** Keep the table ≥ 640px wide (the 08 §4.8 matrix minimum): wide text tables scroll at base instead of squeezing
   *  every column to a word. */
  wide?: boolean;
  /** On a sand/mint band: hairline border instead of shadow (08 §3.3). */
  onTint?: boolean;
  id?: string;
  class?: string;
}

const {
  showCaption = false, rowHeaders = true, table, columnLabels, columnNotes, durationLabel = 'Typical duration',
  wide = false, onTint = false, id, class: cls = '',
} = Astro.props;

const pick = (over: ColumnText | undefined, key: string, i: number): string | undefined =>
  over === undefined ? undefined : Array.isArray(over) ? (over as readonly (string | undefined)[])[i] : (over as Record<string, string>)[key];

let caption: string | undefined;
let rowHeader: string | undefined;
let columns: Column[];
let rows: Row[];
let footnotes: readonly string[];
if (table) {
  caption = Astro.props.caption ?? table.caption;
  rowHeader = Astro.props.rowHeader ?? 'Included';
  columns = table.columns.map((c, i) => {
    // Featured = the pricing.json badge (Full Groom → "Most booked"). Ids pricing.json doesn't know (e.g. a plan id)
    // simply get no badge.
    const badge = getService(c.serviceId)?.badge;
    return { label: pick(columnLabels, c.serviceId, i) ?? c.label, sub: pick(columnNotes, c.serviceId, i) ?? c.note, badge, featured: !!badge };
  });
  rows = [...table.rows];
  if (table.durations?.length) rows.push({ label: durationLabel, cells: table.durations });
  footnotes = [...table.footnotes, ...(Astro.props.footnotes ?? [])];
} else {
  caption = Astro.props.caption;
  rowHeader = Astro.props.rowHeader;
  columns = [...(Astro.props.columns ?? [])];
  rows = [...(Astro.props.rows ?? [])];
  footnotes = Astro.props.footnotes ?? [];
}
if (!caption) throw new Error('InfoTable: pass a caption (or a C1 `table`)');
if (!rowHeader) throw new Error(`InfoTable "${caption}": pass rowHeader — the first column's header text`);
rows.forEach((r) => {
  if (r.cells.length !== columns.length) {
    throw new Error(`InfoTable "${caption}": row "${r.label}" has ${r.cells.length} cells for ${columns.length} columns`);
  }
});
// A column holding any ✓/— is centred (header, marks and any text in it, e.g. the durations row).
const centred = columns.map((_, i) => rows.some((r) => typeof r.cells[i] === 'boolean'));
const hasNotes = footnotes.length > 0 || Astro.slots.has('default');
---
<div id={id} class:list={['it', cls]}>
  <TableFrame label={caption} onTint={onTint}>
    <table class:list={['it-table w-full border-collapse text-left', { 'it-wide': wide, 'it-flat': !rowHeaders }]}>
      <caption class:list={[showCaption ? 'tf-caption' : 'sr-only']}>{caption}</caption>
      <thead>
        <tr>
          <th scope="col" class="t-h4">{rowHeader}</th>
          {columns.map((c, i) => (
            <th scope="col" class:list={['t-h4', { 'it-c it-col-c': centred[i], 'it-col-sub': (c.sub?.length ?? 0) > 24, 'is-featured': c.featured }]}>
              {c.label}
              {c.sub ? <span class="block text-sm font-normal">{priceParts(c.sub).map((p) => (p.figure ? <span class="t-price">{p.text}</span> : p.text))}</span> : null}
              {c.badge ? <span class:list={['t-micro mt-1 flex h-6 w-max items-center rounded-pill bg-cta px-2 text-ink', { 'mx-auto': centred[i] }]}>{c.badge}</span> : null}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            {rowHeaders ? (
              <th scope="row" class="it-label font-medium leading-snug text-ink">{r.label}</th>
            ) : (
              <td class="it-text text-sm text-ink">{r.label}</td>
            )}
            {r.cells.map((cell, i) => (
              <td
                class:list={[
                  typeof cell === 'string' ? ['text-sm text-ink', centred[i] ? 'whitespace-nowrap' : 'it-text'] : '',
                  { 'it-c': centred[i], 'is-featured': columns[i].featured },
                ]}
              >
                {cell === true ? (
                  <><Icon name="check" size={20} class="inline-block align-middle text-brand" /><span class="sr-only">Included</span></>
                ) : cell === false ? (
                  <><span aria-hidden="true" class="text-slate">—</span><span class="sr-only">Not included</span></>
                ) : (
                  priceParts(cell).map((p) => (p.figure ? <span class="t-price">{p.text}</span> : p.text))
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </TableFrame>

  {hasNotes ? (
    <div class="mt-3 space-y-1 text-sm text-slate">
      {footnotes.map((f) => <p class="m-0">{f}</p>)}
      <slot />
    </div>
  ) : null}
</div>

<style>
  .it-wide { min-width: 640px; }
  .it-c { text-align: center; }

  /* Base (< md): column floors, so nothing collapses to one word per line — the table scrolls sideways instead (the
     floors include the cell padding). The sticky row-label column stays under half of a 360px screen and wraps; ✓
     columns fit a short header on ≤ 2 lines; a header with a long note (> 24 characters, e.g. PR-4's Full Groom
     note) gets room for it; text cells stay readable. */
  .it-label { min-width: 9.5rem; }
  .it-col-c { min-width: 7.5rem; }
  .it-col-sub { min-width: 11rem; }
  .it-text { min-width: 7rem; }

  /* No row headers (rowHeaders={false}): nothing is sticky. */
  .it-flat thead th:first-child { position: static; box-shadow: none; }

  /* ≥ md the table fits its container (08 §4.8): the floors go. */
  @media (min-width: 768px) {
    .it-label,
    .it-col-c,
    .it-col-sub,
    .it-text { min-width: 0; }
  }
</style>
