---
// Footer (08-DESIGN-SYSTEM §4.4). NAP values verbatim from 05-LOCAL-SEO §4 via src/data/site.ts —
// identical crawlable text on every page; no street address ever (service-area business).
import Logo from './Logo.astro';
import PawMark from './icons/PawMark.astro';
import BrandIcon from './icons/BrandIcon.astro';
import { isLive, liveRoutes, routes } from '../data/routes';
import { areas } from '../lib/pricing';
import { instagramHref, site, telHref, waHref, WA_DEFAULT_TEXT } from '../data/site';

const services = liveRoutes('service').filter((r) => r.path !== '/ludhiana/');
const TOP5 = ['sarabha-nagar', 'brs-nagar', 'model-town', 'dugri', 'south-city']; // 05 §2.4 / 08 §4.4
const topAreas = TOP5.map((slug) => routes.find((r) => r.path === `/ludhiana/areas/${slug}/`)).filter((r) => r && r.status === 'live');
const company = ['/pricing/', '/how-it-works/', '/about/', '/contact/', '/faq/', '/reviews/', '/safety-hygiene/', '/offers/', '/join-as-groomer/']
  .map((p) => routes.find((r) => r.path === p)).filter((r) => r && r.status === 'live');
const legal = ['/privacy-policy/', '/terms/', '/refund-policy/'].map((p) => routes.find((r) => r.path === p)).filter((r) => r && r.status === 'live');
const linkCls = 'inline-flex min-h-11 items-center text-mint no-underline hover:underline';
const year = new Date().getFullYear();
---
<footer class="on-dark relative overflow-hidden bg-brand-dark text-sand">
  <PawMark size={220} class="pointer-events-none absolute -bottom-10 -right-8 rotate-[-12deg] text-white opacity-[0.06]" />
  <div class="relative mx-auto grid max-w-[1200px] gap-10 px-4 py-12 md:grid-cols-2 lg:grid-cols-4 lg:px-6">
    <div>
      <Logo variant="dark" />
      <p class="mt-3 text-sand">{site.tagline}</p>
      <p class="mt-2 text-sm">
        <a href={site.gbpLink} class="text-mint underline-offset-[3px] hover:underline" target="_blank" rel="noopener">★ {site.googleRating} on Google · {site.reviewCount}+ Ludhiana pet parents</a>
      </p>
      <p class="mt-3 flex gap-2">
        <a href={instagramHref()} data-source="footer" target="_blank" rel="noopener" class="inline-flex h-11 w-11 items-center justify-center text-mint" aria-label="PetDoorStep on Instagram">
          <BrandIcon name="instagram" size={24} />
        </a>
        <a href={waHref(WA_DEFAULT_TEXT)} data-source="footer" target="_blank" rel="noopener" class="inline-flex h-11 w-11 items-center justify-center text-wa" aria-label="Chat with PetDoorStep on WhatsApp">
          <BrandIcon name="whatsapp" size={24} />
        </a>
      </p>
    </div>

    {services.length ? (
      <div>
        <h2 class="t-micro font-body text-white">Services</h2>
        <ul class="mt-3 list-none p-0">{services.map((s) => <li><a href={s.path} class={linkCls}>{s.label}</a></li>)}</ul>
      </div>
    ) : null}

    {topAreas.length ? (
      <div>
        <h2 class="t-micro font-body text-white">Areas</h2>
        <ul class="mt-3 list-none p-0">{topAreas.map((a) => <li><a href={a!.path} class={linkCls}>Pet grooming in {a!.label}</a></li>)}</ul>
      </div>
    ) : null}

    <div>
      {company.length ? (
        <>
          <h2 class="t-micro font-body text-white">Company</h2>
          <ul class="mt-3 list-none p-0">{company.map((c) => <li><a href={c!.path} class={linkCls}>{c!.label}</a></li>)}</ul>
        </>
      ) : null}
      <h2 class="t-micro mt-6 font-body text-white">Contact</h2>
      <address class="mt-3 text-sm not-italic leading-relaxed text-sand" data-testid="nap">
        {site.name} · {site.city}, {site.region} — doorstep service across {areas.join(', ')}<br />
        <a href={telHref()} data-source="footer" class="text-mint">{site.phone}</a> ·{' '}
        WhatsApp <a href={waHref(WA_DEFAULT_TEXT)} data-source="footer" target="_blank" rel="noopener" class="text-mint">{site.whatsapp}</a> ·{' '}
        <a href={`mailto:${site.email}`} class="text-mint">{site.email}</a><br />
        {site.hours.visits}
      </address>
    </div>
  </div>
  <div class="relative border-t border-white/15">
    <div class="mx-auto flex max-w-[1200px] flex-wrap items-center gap-x-4 gap-y-1 px-4 py-4 text-[0.8125rem] text-sand/70 lg:px-6">
      <span>© {year} {site.name}</span>
      {legal.map((l) => <a href={l!.path} class="text-sand/70 no-underline hover:underline">{l!.label}</a>)}
    </div>
  </div>
</footer>
