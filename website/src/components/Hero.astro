---
// Hero (08-DESIGN-SYSTEM §4.6; formula + copy 06-CONVERSION-PLAYBOOK §2; template SP-1, home H-1, area AP-1).
// DOM order: eyebrow · H1 · subhead · (Hinglish support line) · CTA row · chip row · R3 line · photo.
// Base: one column; the chips come straight after the CTAs so the first trust chip makes the 360×640 fold
// (08 §4.6 / 02 P150). ≥ md: 7fr/5fr columns, and the R3 line moves up to sit directly under the CTAs (CSS order;
// it is not focusable, so tab order is unchanged). The photo is the LCP: eager + fetchpriority high. Its <head>
// preload is <Photo preset="hero" preload …> in the page's head slot (04 §5.2.2).
import Button from './Button.astro';
import Chip from './Chip.astro';
import Photo from './Photo.astro';
import PawMark from './icons/PawMark.astro';
import { R3, TRUST_CHIPS } from '../data/content';

type Variant = 'primary' | 'whatsapp' | 'secondary' | 'ghost' | 'on-dark';
interface Cta {
  label: string;
  href: string;
  /** Default: 'whatsapp' for wa.me links, else 'primary' (primary CTA) / 'secondary' (secondary CTA). */
  variant?: Variant;
  /** 09 §2d source value, e.g. 'hero_home' or 'hero_dog-grooming' (also put it in the /book/?src= param). */
  source: string;
}
interface Props {
  eyebrow?: string;
  h1: string;
  subhead: string;
  /** Optional Hinglish support line (00 §3.1: site.taglineHinglish), shown under the subhead. */
  hinglish?: string;
  primary: Cta;
  secondary?: Cta;
  /** First chip, price style: built from pricing helpers, e.g. SERVICE_PRICE_CHIP[path] or LOWEST_PRICE_CHIP. */
  priceChip?: string;
  /** Trust chips: default = the 06 §2.1 standard set. Pass the page's 06 §2.3 override set where it has one. */
  trustChips?: readonly string[];
  /** Hero photo: planned 08 §5.2 filename + 08 §5.4 alt. Omit for a compact text-only hero (e.g. /pricing/). */
  photo?: { name: string; alt: string; position?: string };
  /** Reply-time line under the CTAs. Default R3 (06 §9); false hides it. */
  reply?: string | false;
}

const {
  eyebrow, h1, subhead, hinglish, primary, secondary, priceChip,
  trustChips = TRUST_CHIPS, photo, reply = R3,
} = Astro.props;

const variantOf = (cta: Cta, fallback: Variant): Variant => cta.variant ?? (cta.href.includes('wa.me') ? 'whatsapp' : fallback);
const hasChips = !!priceChip || trustChips.length > 0;
// Hero padding 64 → 96 at lg (08 §3.1). The base top is 16px, not 64: at 360×640 a 64px top pushes the primary CTA
// and the first chip under the sticky bar, and the fold law (02 P150) is a launch blocker.
const wrap = 'mx-auto grid max-w-[1200px] grid-cols-1 gap-8 px-4 pb-16 pt-4 md:gap-10 md:pt-16 lg:gap-12 lg:px-6 lg:py-24';
---
<section aria-labelledby="hero-heading" class="hero">
  <div
    class:list={[wrap, photo ? 'md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-center' : '']}
  >
    <div class="min-w-0">
      {eyebrow ? <p class="t-micro m-0 text-brand">{eyebrow}</p> : null}
      <h1 id="hero-heading" class:list={['t-display m-0', eyebrow ? 'mt-2' : '']}>{h1}</h1>
      <p class="t-body-lg measure m-0 mt-3 text-slate">{subhead}</p>
      {hinglish ? <p class="m-0 mt-2 text-sm font-medium text-brand-deep">{hinglish}</p> : null}

      <div class="mt-4 flex flex-col md:mt-5">
        <div class="flex flex-col gap-2 md:flex-row md:flex-wrap md:gap-3">
          <Button href={primary.href} variant={variantOf(primary, 'primary')} source={primary.source} full>{primary.label}</Button>
          {secondary ? (
            <Button href={secondary.href} variant={variantOf(secondary, 'secondary')} source={secondary.source} full>{secondary.label}</Button>
          ) : null}
        </div>
        {hasChips ? (
          <ul class="chip-row hero-chips m-0 mt-2 list-none p-0 md:order-2 md:mt-4">
            {priceChip ? <li><Chip kind="price" label={priceChip} /></li> : null}
            {trustChips.map((t) => <li><Chip kind="trust" label={t} /></li>)}
          </ul>
        ) : null}
        {reply ? <p class="m-0 mt-2 text-sm text-slate md:order-1">{reply}</p> : null}
      </div>
    </div>

    {photo ? (
      <div class="relative min-w-0">
        <PawMark size={160} class="pointer-events-none absolute -bottom-12 -left-12 hidden rotate-[-12deg] text-brand opacity-5 md:block" />
        <Photo
          name={photo.name}
          alt={photo.alt}
          preset="hero"
          position={photo.position}
          eager
          class="relative block aspect-[16/10] h-auto w-full rounded-lg object-cover md:aspect-[4/3] md:rounded-xl md:shadow-1"
        />
      </div>
    ) : null}
  </div>
</section>

<style>
  /* Base: the chip row is one horizontal scroll-snap line with an edge fade (08 §4.6); ≥ md it wraps (global .chip-row). */
  .hero-chips {
    padding-right: 32px; /* lets the last chip scroll clear of the 32px fade */
    -webkit-mask-image: linear-gradient(to right, black calc(100% - 32px), transparent);
    mask-image: linear-gradient(to right, black calc(100% - 32px), transparent);
  }
  @media (min-width: 768px) {
    .hero-chips { padding-right: 0; -webkit-mask-image: none; mask-image: none; }
  }
</style>
