---
// Shell of the two legal pages (website-plan/blueprints/privacy-policy.md B19 PP-0/PP-1, terms.md B20 TM-0/TM-1):
// Base (indexable, self-canonical; Base keeps the exit card off these paths) with the 04 §2.9 legal-page JSON-LD
// (BreadcrumbList only), the 2-item breadcrumb, the header block (H1 · "Effective from …" · "Last updated: …" · intro)
// and the on-page contents list, then the page's sections (default slot). Zero JS.
//
// Layout: one reading column — 760px of content (808px box minus the 24px lg gutters, 16px below lg, 08 §3.1),
// centred, with the breadcrumb in the same box so both start on one line. Paragraphs sit in <div class="prose">
// (65ch measure); tables, cards and the contents list may use the full column width.
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../Breadcrumb.astro';
import { IDENTITY } from '../../../data/legal';
import { routeLabel } from '../../../data/routes';
import { schemaGraphLd } from '../../../lib/schema';
import type { TocEntry } from './legal-page';

interface Props {
  /** <title> and meta description: the blueprint §1 head lines, verbatim. */
  title: string;
  description: string;
  path: '/privacy-policy/' | '/terms/';
  h1: string;
  /** The page's H2 sections, in DOM order — the contents list links each one. */
  toc: readonly TocEntry[];
}

const { title, description, path, h1, toc } = Astro.props;
// PP-0 / TM-0: "Home › Privacy Policy" / "Home › Terms" — labels from routes.ts, the names the footer legal row uses.
const crumbs = [
  { label: routeLabel('/'), path: '/' },
  { label: routeLabel(path), path },
];
---
<Base title={title} description={description} path={path} jsonLd={[schemaGraphLd({ type: 'breadcrumb-only', crumbs }, Astro.site)]}>
  <div class="mx-auto max-w-[808px]"><Breadcrumb items={crumbs} /></div>

  <div class="mx-auto max-w-[808px] px-4 pb-16 lg:px-6 lg:pb-24">
    <header class="pt-2 md:pt-4">
      <h1 class="t-h1 m-0 text-balance">{h1}</h1>
      <div class="mt-3 text-sm text-slate">
        <p class="m-0">Effective from {IDENTITY.POLICY_EFFECTIVE_DATE}.</p>
        <p class="m-0">Last updated: {IDENTITY.POLICY_EFFECTIVE_DATE}</p>
      </div>
      <div class="prose mt-5 md:text-lg"><slot name="intro" /></div>
    </header>

    <nav aria-labelledby="legal-contents-label" class="mt-8 rounded-lg border border-line bg-sand px-4 pb-2 pt-4 md:px-6">
      <p id="legal-contents-label" class="t-micro m-0 text-slate">On this page</p>
      <ol class="m-0 mt-1 grid list-none p-0 md:grid-cols-2 md:gap-x-8">
        {toc.map((s) => (
          <li><a href={`#${s.id}`} class="prose-link flex min-h-11 items-center py-1 leading-snug">{s.label}</a></li>
        ))}
      </ol>
    </nav>

    <slot />
  </div>
</Base>
