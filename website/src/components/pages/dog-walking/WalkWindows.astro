---
// /ludhiana/dog-walking/ SP-4 H3 "Ludhiana walk windows by season" (blueprints/dog-walking.md §3 SP-4, verbatim; the
// hours are 00 §3.1's walk hours + the Apr–Jun heat rule — the same values as site.ts hours.walks and the SP-6 step-3
// line, checked at build time in src/data/pages/dog-walking.ts). Goes in ServicePage's `sp4-extra` slot: the end of
// the price block, after the mid-page CTA and the /pricing/ link, on the sand SP-4 band — onTint. Carries the §2
// long-tail "morning evening dog walker · daily dog walking". A 3-column text table set `wide` (the 08 §4.8 640px
// minimum): below md it scrolls sideways behind the fade with the Months column sticky; from md it fits. Measured at
// 360 (decisions/w1-walk.md W1W-07): with the default column floors the Why column was 112px wide and its Apr–Jun
// cell 7 lines tall (table 589px); `wide` gives Months 158 · Walk windows 214 · Why 268 and 2–3-line rows (table
// 336px). 768 and 1280 are unchanged either way (the floors go at md).
import InfoTable from '../../InfoTable.astro';
import { HEADINGS, WALK_WINDOWS } from '../../../data/pages/dog-walking';

const columns = WALK_WINDOWS.columns.map((label) => ({ label }));
---
<div class="mt-12">
  <h3 id="walk-windows" class="t-h3 m-0">{HEADINGS.windows}</h3>
  <InfoTable caption={HEADINGS.windows} rowHeader={WALK_WINDOWS.rowHeader} columns={columns} rows={WALK_WINDOWS.rows} wide onTint class="mt-4" />
</div>
