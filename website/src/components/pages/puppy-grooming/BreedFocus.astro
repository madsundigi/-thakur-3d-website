---
// /ludhiana/puppy-grooming/ SP-4 addition — H3 "Popular first-groom breeds" (blueprints/puppy-grooming.md §3 SP-4,
// verbatim: 6 rows; carries the "shih tzu / labrador / beagle puppy grooming" breed long-tails). Goes in ServicePage's
// `sp4-extra` slot, after the mid-page CTA and the /pricing/ link, on the sand SP-4 band: onTint. A wide text table
// (08 §4.8 640px minimum): it scrolls sideways below md, sticky Breed column. No ₹ figure here.
import InfoTable from '../../InfoTable.astro';

const BREEDS = 'Popular first-groom breeds';
const columns = [{ label: 'First-groom focus' }];
const rows = [
  { label: 'Shih Tzu', cells: ['Face and eye area, getting used to daily brushing'] },
  { label: 'Labrador', cells: ['Bath acceptance and nail tips'] },
  { label: 'Beagle', cells: ['Ear cleaning (floppy ears trap moisture)'] },
  { label: 'Pomeranian', cells: ['Brushing tolerance for the coming double coat'] },
  { label: 'Golden Retriever', cells: ['Brushing and feathering tidy'] },
  { label: 'Indie', cells: ['Calm handling and a full tick check'] },
];
---
<div class="mt-12">
  <h3 id="popular-first-groom-breeds" class="t-h3 m-0">{BREEDS}</h3>
  <InfoTable caption={BREEDS} rowHeader="Breed" columns={columns} rows={rows} wide onTint class="mt-4" />
</div>
