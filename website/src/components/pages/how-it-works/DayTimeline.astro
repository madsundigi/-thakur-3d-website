---
// HW-3 "On the day" (website-plan/blueprints/how-it-works.md): what happens after booking, as a numbered timeline.
// Same visual language as StepsStrip (08-DESIGN-SYSTEM §4.9): 40px brand discs with white numerals on a rail, joined
// by a 2px dashed line-colour connector. Base: one column. ≥ md: two columns read top to bottom (1–3 | 4–6), so the
// sequence never zig-zags; the connector stops at the foot of each column. Zero JS.
interface Props {
  heading: string;
  /** The steps, verbatim from the blueprint, in order. */
  steps: readonly string[];
  /** id of the h2 (aria-labelledby). */
  headingId?: string;
}
const { heading, steps, headingId = 'day-heading' } = Astro.props;
const rows = Math.ceil(steps.length / 2); // ≥ md: rows per column
---
<section aria-labelledby={headingId}>
  <h2 id={headingId} class="t-h2 m-0">{heading}</h2>
  <ol class="day mt-6 grid list-none gap-4 p-0" style={`--day-rows: ${rows}`}>
    {steps.map((text, i) => (
      <li class:list={['day-step relative flex gap-3', { 'day-col-end': i === rows - 1 }]}>
        <span class="flex h-10 w-10 flex-none items-center justify-center rounded-pill bg-brand font-bold text-white">{i + 1}</span>
        <p class="m-0 min-w-0 pt-2 text-ink">{text}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  /* Connector (08 §4.9): 2px dashed line colour from 8px under one disc to 8px above the next (the row gap is 16px). */
  .day-step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 19px; /* centred on the 40px disc */
    top: 48px;
    bottom: -8px;
    border-left: 2px dashed var(--color-line);
  }
  @media (min-width: 768px) {
    .day {
      grid-auto-flow: column;
      grid-template-rows: repeat(var(--day-rows), auto);
      grid-auto-columns: minmax(0, 1fr);
      column-gap: 40px;
    }
    /* The last step of the first column has no next step below it. */
    .day-step.day-col-end::after { display: none; }
  }
</style>
