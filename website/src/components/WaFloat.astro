---
// Desktop WhatsApp float (08-DESIGN-SYSTEM §4.17) — ≥ 768px only; source "float_desktop" (08 §0.4).
// Wrapped in an <aside> landmark so no page content sits outside a landmark (08 §7.5; axe "region").
import BrandIcon from './icons/BrandIcon.astro';
import { waHref } from '../data/site';
interface Props { waText: string }
const { waText } = Astro.props;
---
<aside aria-label="WhatsApp chat" class="fixed bottom-6 right-6 z-40 hidden md:block">
  <a
    href={waHref(waText)}
    data-source="float_desktop"
    target="_blank"
    rel="noopener"
    aria-label="Chat with PetDoorStep on WhatsApp"
    class="flex h-14 w-14 items-center justify-center rounded-pill bg-wa text-ink shadow-3 transition-transform duration-[120ms] hover:scale-105 hover:bg-wa-hover"
  >
    <BrandIcon name="whatsapp" size={28} />
  </a>
</aside>
