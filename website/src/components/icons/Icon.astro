---
// Lucide icons inlined at build — no icon font, no runtime JS (08-DESIGN-SYSTEM §6.1). Stroke 1.5, currentColor.
// The complete 08 §6.2 launch map + mail + star (lucide-static names; check-circle-2 / alert-circle are Lucide's
// legacy aliases, kept so existing calls keep working). Lucide ships no brand marks, so `instagram` and `facebook`
// render the simple-icons glyphs through BrandIcon. Add icons only via a Decision Log entry (08 §6.2).
import BrandIcon from './BrandIcon.astro';
import phone from 'lucide-static/icons/phone.svg?raw';
import check from 'lucide-static/icons/check.svg?raw';
import circleCheck from 'lucide-static/icons/circle-check.svg?raw';
import shieldCheck from 'lucide-static/icons/shield-check.svg?raw';
import mapPin from 'lucide-static/icons/map-pin.svg?raw';
import calendarDays from 'lucide-static/icons/calendar-days.svg?raw';
import clock from 'lucide-static/icons/clock.svg?raw';
import chevronRight from 'lucide-static/icons/chevron-right.svg?raw';
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import plus from 'lucide-static/icons/plus.svg?raw';
import circleAlert from 'lucide-static/icons/circle-alert.svg?raw';
import footprints from 'lucide-static/icons/footprints.svg?raw';
import syringe from 'lucide-static/icons/syringe.svg?raw';
import stethoscope from 'lucide-static/icons/stethoscope.svg?raw';
import bug from 'lucide-static/icons/bug.svg?raw';
import camera from 'lucide-static/icons/camera.svg?raw';
import sparkles from 'lucide-static/icons/sparkles.svg?raw';
import scissors from 'lucide-static/icons/scissors.svg?raw';
import dog from 'lucide-static/icons/dog.svg?raw';
import cat from 'lucide-static/icons/cat.svg?raw';
import pawPrint from 'lucide-static/icons/paw-print.svg?raw';
import menu from 'lucide-static/icons/menu.svg?raw';
import x from 'lucide-static/icons/x.svg?raw';
import mail from 'lucide-static/icons/mail.svg?raw';
import star from 'lucide-static/icons/star.svg?raw';

const icons = {
  phone, check, 'check-circle-2': circleCheck, 'circle-check': circleCheck, 'shield-check': shieldCheck,
  'map-pin': mapPin, 'calendar-days': calendarDays, clock, 'chevron-right': chevronRight, 'arrow-right': arrowRight,
  plus, 'alert-circle': circleAlert, 'circle-alert': circleAlert, footprints, syringe, stethoscope, bug, camera,
  sparkles, scissors, dog, cat, 'paw-print': pawPrint, menu, x, mail, star,
} as const;
const brands = ['instagram', 'facebook'] as const;

export type IconName = keyof typeof icons | (typeof brands)[number];

interface Props {
  name: IconName;
  size?: number;
  /** Fill the shape with currentColor (e.g. solid review stars, 08 §4.11). Default: outline, per 08 §6.1. */
  filled?: boolean;
  class?: string;
}

const { name, size = 20, filled = false, class: cls = '' } = Astro.props;
const brand = (brands as readonly string[]).includes(name) ? (name as (typeof brands)[number]) : null;
const raw = brand ? '' : icons[name as keyof typeof icons];
if (!brand && !raw) throw new Error(`Icon: unknown icon "${name}" — the launch set is 08-DESIGN-SYSTEM §6.2`);
const svg = raw
  .replace(/<!--[\s\S]*?-->/, '')
  .replace(/class="[^"]*"/, `class="${cls}"`)
  .replace('width="24"', `width="${size}"`)
  .replace('height="24"', `height="${size}"`)
  .replace('stroke-width="2"', 'stroke-width="1.5"')
  .replace('fill="none"', filled ? 'fill="currentColor"' : 'fill="none"')
  .replace('<svg', '<svg aria-hidden="true" focusable="false"')
  .trim();
---
{brand ? <BrandIcon name={brand} size={size} class={cls} /> : <Fragment set:html={svg} />}
