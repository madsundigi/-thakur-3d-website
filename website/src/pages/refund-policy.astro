---
// /refund-policy/ — As-built blueprint: website-plan/blueprints/refund-policy.md (B21), blocks RF-0…RF-7 in DOM order.
// 01-SITEMAP legal row ("Must match what we honour (reschedule/refund rules)"). Built exactly like the Wave-1 legal
// pages (/privacy-policy/, /terms/): Base (indexable, self-canonical, no exit card on this path) + the 2-item
// breadcrumb + the legal header block (H1 · "Effective from …" · "Last updated: …" · intro) + the on-page contents
// list + LegalSection blocks, every paragraph in <div class="prose">. Facts render verbatim from src/data/legal.ts
// (SERVICE_RULES, IDENTITY, LAW) and src/data/content.ts (RESCHEDULE_TEXT — the one site-wide wording of the 00 §3.2
// rule). No ₹ figure is typed here (07 §4). Legal unknowns stay visible [FILL:*] (00 §8, E12). No Hinglish. A lawyer
// reviews the rendered page before launch (00 §9 item 7, D4). Indexable, BreadcrumbList only (04 §2.9). Zero JS.
//
// LegalPage.astro / ContactLink.astro are not reused: their `path` prop is typed `'/privacy-policy/' | '/terms/'`
// (shared components this wave may not edit), so this page inlines the identical shell and contact anchors and reuses
// the path-agnostic LegalSection. A request asks the integrator to widen those unions so this page can adopt them.
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import LegalSection from '../components/pages/legal/LegalSection.astro';
import Icon from '../components/icons/Icon.astro';
import { IDENTITY, LAW, SERVICE_RULES } from '../data/legal';
import { RESCHEDULE_TEXT } from '../data/content';
import { isLive, routeLabel } from '../data/routes';
import { site, waHref } from '../data/site';
import { whatsappDisplay } from '../lib/format';
import { schemaGraphLd } from '../lib/schema';
import { fillSiteTokens, telFor, type TocEntry } from '../components/pages/legal/legal-page';

const PATH = '/refund-policy/';
const SOURCE = 'refund-policy_page'; // 09 §2d `<slug>_page`
// This page's own WhatsApp prefill (02 P158, mirrors the /terms/ PAGE_PREFILL wording) — passed to Base so the
// header, sticky bar and float use it too, and to the in-page Grievance link.
const WA_PREFILL = `Hi PetDoorStep, I have a question about your ${routeLabel(PATH)}: ___`;

// RF-0 / breadcrumb: Home › Refund Policy (labels = the 01-SITEMAP page names in routes.ts).
const crumbs = [
  { label: routeLabel('/'), path: '/' },
  { label: routeLabel(PATH), path: PATH },
];

// ── Sections (the H2s and the on-page contents list) — headings = the blueprint's block names ────────────────────
const S = {
  pay: { id: 'how-and-when-you-pay', label: 'How and when you pay' }, // RF-2
  cancel: { id: 'rescheduling-and-cancelling', label: 'Rescheduling and cancelling' }, // RF-3
  refunds: { id: 'refunds', label: 'Refunds' }, // RF-4
  wrong: { id: 'if-something-goes-wrong', label: 'If something goes wrong' }, // RF-5
  changes: { id: 'changes-to-this-policy', label: 'Changes to this policy' }, // RF-6
} satisfies Record<string, TocEntry>;

/** A SERVICE_RULES rule's text, verbatim (a site.ts value fills its token, as /terms/ and faq.ts do). */
const rule = (id: string): string => fillSiteTokens(SERVICE_RULES.find((r) => r.id === id)!.text);

const termsLive = isLive('/terms/');
const privacyLive = isLive('/privacy-policy/');
const waAnchor = waHref(WA_PREFILL);
---
<Base
  title="Refund & Cancellation Policy for Pet Care | PetDoorStep"
  description="How payment, rescheduling, cancelling and refunds work at PetDoorStep in Ludhiana: no advance payment, free changes until 2 hours before your confirmed slot."
  path={PATH}
  waText={WA_PREFILL}
  jsonLd={[schemaGraphLd({ type: 'breadcrumb-only', crumbs }, Astro.site)]}
>
  <div class="mx-auto max-w-[808px]"><Breadcrumb items={crumbs} /></div>

  <div class="mx-auto max-w-[808px] px-4 pb-16 lg:px-6 lg:pb-24">
    {/* RF-1 · header */}
    <header class="pt-2 md:pt-4">
      <h1 class="t-h1 m-0 text-balance">Refund and Cancellation Policy</h1>
      <div class="mt-3 text-sm text-slate">
        <p class="m-0">Effective from {IDENTITY.POLICY_EFFECTIVE_DATE}.</p>
        <p class="m-0">Last updated: {IDENTITY.POLICY_EFFECTIVE_DATE}</p>
      </div>
      <div class="prose mt-5 md:text-lg">
        <p>
          PetDoorStep never takes an advance payment: you pay only after the service, at the price we confirm on
          WhatsApp. So there is nothing to pay upfront and, in the usual case, nothing to refund. This page explains
          how and when you pay, how to reschedule or cancel, when a refund can apply, and what happens if you are not
          happy with a visit.{' '}
          {termsLive ? <>It is part of our <a href="/terms/">{routeLabel('/terms/')}</a>.</> : 'It is part of our Terms of Service.'}
        </p>
      </div>
    </header>

    <nav aria-labelledby="legal-contents-label" class="mt-8 rounded-lg border border-line bg-sand px-4 pb-2 pt-4 md:px-6">
      <p id="legal-contents-label" class="t-micro m-0 text-slate">On this page</p>
      <ol class="m-0 mt-1 grid list-none p-0 md:grid-cols-2 md:gap-x-8">
        {Object.values(S).map((s) => (
          <li><a href={`#${s.id}`} class="prose-link flex min-h-11 items-center py-1 leading-snug">{s.label}</a></li>
        ))}
      </ol>
    </nav>

    {/* RF-2 · How and when you pay (pay-after · mrp · add-ons-first — verbatim SERVICE_RULES) */}
    <LegalSection entry={S.pay}>
      <div class="prose">
        <p>{rule('pay-after')}</p>
        <p>{rule('add-ons-first')}</p>
        <p>{rule('mrp')}</p>
      </div>
    </LegalSection>

    {/* RF-3 · Rescheduling and cancelling (RESCHEDULE_TEXT: the one site-wide wording of the 00 §3.2 rule) */}
    <LegalSection entry={S.cancel}>
      <div class="prose">
        <p>{RESCHEDULE_TEXT}</p>
        <ul>
          <li><strong>Cancelling less than 2 hours before your slot:</strong> {IDENTITY.LATE_CANCEL_RULE}</li>
          <li><strong>If nobody is home when we arrive:</strong> {IDENTITY.NO_SHOW_RULE}</li>
        </ul>
        <p>If heavy rain or dense fog means we need to shorten or move a walk, we tell you on WhatsApp first.</p>
      </div>
    </LegalSection>

    {/* RF-4 · Refunds (honest: no advance payment, so nothing to refund in the usual case) */}
    <LegalSection entry={S.refunds}>
      <div class="prose">
        <p>
          Because we never take an advance payment, a deposit or a joining fee, there is normally nothing to refund.
          You pay after the service, so if a visit does not go ahead, no money has changed hands.
        </p>
        <p>
          If you have already paid for a service and something was not right, tell us (see{' '}
          <a href={`#${S.wrong.id}`}>{S.wrong.label}</a>). We would rather put it right — by redoing the part that
          went wrong or adjusting the bill — than leave you out of pocket, and nothing here limits your rights under
          the {LAW.CONSUMER_ACT}.
        </p>
        <p>
          Monthly dog-walking plans are paid at the end of each month, for the walks actually done that month, so there
          is no advance to return if you pause or stop.
        </p>
      </div>
    </LegalSection>

    {/* RF-5 · If something goes wrong (same wording as /terms/ TM-10; no promise on vet-check costs — policy-gated) */}
    <LegalSection entry={S.wrong}>
      <div class="prose">
        <p>{rule('stop-safely')}</p>
        <p>
          If anything goes wrong during a visit, we stop immediately, tell you on the spot and help you get a vet check
          right away, from our partner vet or the nearest clinic.
        </p>
        <p>
          Not happy with a service? Tell us on{' '}
          <a href={waAnchor} data-source={SOURCE} target="_blank" rel="noopener">WhatsApp</a> — a real person reads
          every message. For a formal complaint, contact our Grievance Officer: {IDENTITY.GRIEVANCE_OFFICER_NAME},{' '}
          <a href={`mailto:${IDENTITY.GRIEVANCE_EMAIL}`} class="prose-link">{IDENTITY.GRIEVANCE_EMAIL}</a>,{' '}
          <a href={telFor(IDENTITY.GRIEVANCE_PHONE)} data-source={SOURCE} class="prose-link">{IDENTITY.GRIEVANCE_PHONE}</a>.
        </p>
      </div>
    </LegalSection>

    {/* RF-6 · Changes to this policy + contact line */}
    <LegalSection entry={S.changes}>
      <div class="prose">
        <p>When we change this policy, we update the effective date at the top of this page.</p>
        <p>
          WhatsApp{' '}
          <a href={waAnchor} data-source={SOURCE} target="_blank" rel="noopener" class="prose-link">{whatsappDisplay(site.whatsapp)}</a>{' '}
          · email{' '}
          <a href={`mailto:${site.email}`} class="prose-link">{site.email}</a>
          {privacyLive ? <> · see also our <a href="/privacy-policy/">{routeLabel('/privacy-policy/')}</a></> : null}
        </p>
      </div>
    </LegalSection>
  </div>
</Base>
