  sp5: { kind: 'pairs' },
  sp7: { team: 'groomers' },
  sp9: {
    intro: "Searching 'dog groomer near me'? We groom at homes across Ludhiana — these areas book dog grooming most:",
    prefix: 'Dog grooming at home in',
