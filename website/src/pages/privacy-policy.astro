---
// /privacy-policy/ — blueprint: website-plan/blueprints/privacy-policy.md (B19), blocks PP-0…PP-14 in DOM order.
// Our privacy policy under rule 4 of the IT (Reasonable Security Practices and Procedures and Sensitive Personal Data
// or Information) Rules, 2011 and our notice under the DPDP Act, 2023. Every list and value renders from
// src/data/legal.ts (STORAGE_KEYS, LEAD_COLUMNS + LEAD_COLUMN_LABELS, WAITLIST_COLUMNS, OPERATOR_COLUMNS, PROCESSORS,
// NOT_USED, CROSS_BORDER_NOTE, GA4_EVENTS, GA4_PARAMS, GA4_SETTINGS, RETENTION, RIGHTS, IDENTITY, LAW, CONSENT_TEXT),
// contact values from src/data/site.ts. Legal unknowns stay visible [FILL:*] tokens (00 §8, E12). Copy in the
// blueprint's quotes is used verbatim; a lawyer reviews the rendered page before launch (00 §9 item 7, D4).
// Indexable, BreadcrumbList only (04 §2.9). Zero JS.
import LegalPage from '../components/pages/legal/LegalPage.astro';
import LegalSection from '../components/pages/legal/LegalSection.astro';
import LegalTable from '../components/pages/legal/LegalTable.astro';
import LegalRow from '../components/pages/legal/LegalRow.astro';
import LegalCell from '../components/pages/legal/LegalCell.astro';
import LawRef from '../components/pages/legal/LawRef.astro';
import ContactLink from '../components/pages/legal/ContactLink.astro';
import Icon from '../components/icons/Icon.astro';
import BrandIcon from '../components/icons/BrandIcon.astro';
import {
  CONSENT_TEXT, CROSS_BORDER_NOTE, GA4_EVENTS, GA4_PARAMS, GA4_SETTINGS, IDENTITY, LAW, LEAD_COLUMN_LABELS,
  LEAD_COLUMNS, NOT_USED, OPERATOR_COLUMNS, PROCESSORS, RETENTION, RIGHTS, STORAGE_KEYS, WAITLIST_COLUMNS,
  fillContact, type StorageStore,
} from '../data/legal';
import { R3 } from '../data/content';
import { isLive } from '../data/routes';
import { site } from '../data/site';
import { whatsappDisplay } from '../lib/format';
import { check, isUrl, numberWord, type TocEntry } from '../components/pages/legal/legal-page';

const PATH = '/privacy-policy/';

// ── Sections (the H2s and the on-page contents list) — headings = the blueprint's block names ────────────────────
const S = {
  who: { id: 'who-we-are', label: 'Who we are' }, // PP-2
  collect: { id: 'what-we-collect', label: 'What we collect and why' }, // PP-3
  use: { id: 'how-we-use-your-data', label: 'How we use your data — the YES rule' }, // PP-4
  share: { id: 'who-else-handles-your-data', label: 'Who else handles your data' }, // PP-5
  device: { id: 'cookies', label: 'Cookies and data saved on your device' }, // PP-6
  stats: { id: 'website-statistics', label: 'Website statistics (Google Analytics)' }, // PP-7
  keep: { id: 'how-long-we-keep-your-data', label: 'How long we keep your data' }, // PP-8
  protect: { id: 'how-we-protect-your-data', label: 'How we protect your data' }, // PP-9
  rights: { id: 'your-rights', label: 'Your rights' }, // PP-10
  grievance: { id: 'grievance-officer', label: 'Grievance Officer' }, // PP-11
  children: { id: 'children', label: 'Children' }, // PP-12
  changes: { id: 'changes-to-this-policy', label: 'Changes to this policy' }, // PP-13
  contact: { id: 'contact-us', label: 'Contact us' }, // PP-14
} satisfies Record<string, TocEntry>;

// ── PP-3: what the lead sheet holds, in plain English (LEAD_COLUMN_LABELS; service id and label print once) ─────────
const labelsOf = (cols: readonly string[]): string[] => {
  const missing = cols.filter((c) => !LEAD_COLUMN_LABELS[c]);
  check(!missing.length, `LEAD_COLUMN_LABELS has no plain-English label for ${missing.join(', ')}`);
  return [...new Set(cols.map((c) => LEAD_COLUMN_LABELS[c]))];
};
const bookingDetails = labelsOf(LEAD_COLUMNS);
const waitlistDetails = labelsOf(WAITLIST_COLUMNS);
const teamNotes = labelsOf(OPERATOR_COLUMNS);
const jobsLive = isLive('/join-as-groomer/'); // PP-3 row ⑧ appears once /join-as-groomer/ is live

// ── PP-4 / PP-7: the 09 §9.5 paragraphs, contact slots filled from site.ts ─────────────────────────────────────────
const contact = { whatsapp: whatsappDisplay(site.whatsapp), email: site.email };
const consent = (title: string) => {
  const item = CONSENT_TEXT.find((c) => c.title === title);
  check(item, `CONSENT_TEXT has no "${title}" paragraph (09 §9.5)`);
  const body = fillContact(item.body, contact);
  check(!/\{(whatsapp|email)\}/.test(body), `CONSENT_TEXT "${title}" still has an unfilled {whatsapp}/{email} slot`);
  return { title: item.title, body };
};
const useParas = [consent('Bookings & WhatsApp'), consent('Reminders, reviews & offers')];
const analytics = consent('Analytics');

// ── PP-5: Web3Forms backup line ───────────────────────────────────────────────────────────────────────────────────
const backup = PROCESSORS.find((p) => /web3forms/i.test(p.name));
check(backup, 'PROCESSORS no longer lists Web3Forms, but PP-5 says backup emails arrive through it');

// ── PP-6: cookies + on-device storage ─────────────────────────────────────────────────────────────────────────────
const cookies = STORAGE_KEYS.filter((k) => k.store === 'cookie');
check(cookies.length > 0 && cookies.every((k) => k.purpose.startsWith('Google Analytics')), 'every cookie in STORAGE_KEYS must be a Google Analytics one ("Google Analytics sets … cookies")');
check(GA4_SETTINGS.liveDomainOnly, 'GA4_SETTINGS.liveDomainOnly is off, but the page says the cookies are set on the live website only');
const cookieCount = `${numberWord(cookies.length)} cookie${cookies.length === 1 ? '' : 's'}`;
const WHERE: Record<StorageStore, string> = {
  localStorage: 'Your browser (local storage)',
  sessionStorage: 'Your browser (session storage)',
  cookie: 'Your browser (cookie)',
};
const idKey = STORAGE_KEYS.find((k) => k.key.includes('<id>'))?.key; // _ga_<id>: explain the placeholder once

// ── PP-7: every claim in the list is a GA4_SETTINGS value; the build stops if one changes ─────────────────────────
check(!GA4_SETTINGS.googleSignals, 'GA4_SETTINGS.googleSignals is on — PP-7 says it is switched off');
check(!GA4_SETTINGS.googleAdsLinked && !GA4_SETTINGS.remarketing && !GA4_SETTINGS.audienceExport, 'GA4_SETTINGS links Google Ads / remarketing / audience export — PP-7 says none');
check(!GA4_SETTINGS.heatmapsOrRecording, 'GA4_SETTINGS.heatmapsOrRecording is on — PP-7 says none');
check(!GA4_SETTINGS.ipAddressesLogged, 'GA4_SETTINGS.ipAddressesLogged is on — PP-7 says IP addresses are not logged or stored');
check(GA4_SETTINGS.areaText.stripDigits, 'GA4_SETTINGS.areaText.stripDigits is off — PP-7 says digits are removed');
// The lead's identity fields (LEAD_COLUMNS `name`, `phone`) — or any other name/phone/email parameter — must never be
// an event parameter ("step_name" is the booking step's name, not a person's).
check(!GA4_PARAMS.some((p) => ['name', 'phone', 'mobile', 'email', 'user_name', 'phone_number'].includes(p)), `GA4_PARAMS (${GA4_PARAMS.join(', ')}) carries a name or phone field — PP-7 says events never do`);

// ── PP-8: the Google Analytics period must equal the property setting ────────────────────────────────────────────
const gaRetention = RETENTION.find((r) => /google analytics/i.test(r.what));
check(gaRetention?.period === `${GA4_SETTINGS.dataRetentionMonths} months`, `RETENTION's Google Analytics period ("${gaRetention?.period}") ≠ GA4_SETTINGS.dataRetentionMonths (${GA4_SETTINGS.dataRetentionMonths})`);

// ── PP-11 ─────────────────────────────────────────────────────────────────────────────────────────────────────────
const dpbLink = IDENTITY.DPB_COMPLAINT_LINK;
---
<LegalPage
  title="Privacy Policy – How We Handle Your Data | PetDoorStep"
  description="How PetDoorStep handles your booking details in Ludhiana: what we store and why, WhatsApp, Google Analytics, how long we keep data and your rights."
  path={PATH}
  h1="Privacy Policy — How PetDoorStep Handles Your Data"
  toc={Object.values(S)}
>
  {/* PP-1 · summary (D4 · 09 §9.3/§9.5) */}
  <Fragment slot="intro">
    <p>
      This policy explains what personal data PetDoorStep collects when you use this website or book with us, why we
      collect it, who handles it, how long we keep it and the choices you have. In short: we use your booking details
      only to handle your booking, we send reminders, review requests and offers on WhatsApp only after you reply YES,
      and we never sell your data.
    </p>
  </Fragment>

  {/* PP-2 · Who we are */}
  <LegalSection entry={S.who}>
    <div class="prose">
      <p>
        This website and the PetDoorStep service are run by {IDENTITY.LEGAL_NAME} ("PetDoorStep", "we"), a doorstep
        pet-care service in {site.city}, {site.region}. We come to you; there is no walk-in centre.
      </p>
      <p>
        WhatsApp <ContactLink kind="whatsapp" page={PATH} /> · email <ContactLink kind="email" page={PATH} />
      </p>
    </div>
  </LegalSection>

  {/* PP-3 · What we collect and why */}
  <LegalSection entry={S.collect}>
    <LegalTable
      caption="What we collect, why we collect it and the legal basis"
      columns={['What', 'Details', 'Why', 'Legal basis']}
      widths={[17, 37, 26, 20]}
    >
      <LegalRow>
        <LegalCell head>Booking form</LegalCell>
        <LegalCell label="Details"><ul>{bookingDetails.map((d) => <li>{d}</li>)}</ul></LegalCell>
        <LegalCell label="Why">To confirm the booking on WhatsApp, price it and arrange the visit.</LegalCell>
        <LegalCell label="Legal basis">You give it to us to book.<LawRef>DPDP Act s.7(a)</LawRef></LegalCell>
      </LegalRow>
      <LegalRow>
        <LegalCell head>Waitlist (Outside Ludhiana)</LegalCell>
        <LegalCell label="Details"><ul>{waitlistDetails.map((d) => <li>{d}</li>)}</ul></LegalCell>
        <LegalCell label="Why">To send you one WhatsApp message the day we start in your area.</LegalCell>
        <LegalCell label="Legal basis">You give it to us to join the waitlist.<LawRef>DPDP Act s.7(a)</LawRef></LegalCell>
      </LegalRow>
      <LegalRow>
        <LegalCell head>WhatsApp chat</LegalCell>
        <LegalCell label="Details">Your WhatsApp number and profile name, and the messages and photos you send us.</LegalCell>
        <LegalCell label="Why">To confirm and run your booking, and, if you choose to answer, to note how you heard about us.</LegalCell>
        <LegalCell label="Legal basis">You send it to us for your booking.<LawRef>DPDP Act s.7(a)</LawRef></LegalCell>
      </LegalRow>
      <LegalRow>
        <LegalCell head>Visit photos</LegalCell>
        <LegalCell label="Details">Photos of your pet during a groom or walk.</LegalCell>
        <LegalCell label="Why">
          <p>Sent to you as the photo update.</p>
          <p>Featured on our website, Instagram or Google profile only after you reply YES.</p>
        </LegalCell>
        <LegalCell label="Legal basis">
          <p>Photo update: part of your booking.<LawRef>DPDP Act s.7(a)</LawRef></p>
          <p>Featuring: your YES on WhatsApp.<LawRef>Consent, DPDP Act s.6</LawRef></p>
        </LegalCell>
      </LegalRow>
      <LegalRow>
        <LegalCell head>Team notes</LegalCell>
        <LegalCell label="Details"><ul>{teamNotes.map((d) => <li>{d}</li>)}</ul></LegalCell>
        <LegalCell label="Why">To keep track of your booking and of how people hear about us, and to know who has replied YES to reminders and offers.</LegalCell>
        <LegalCell label="Legal basis">Part of running your booking. The YES date is our record of your consent.<LawRef>DPDP Act s.7(a)</LawRef></LegalCell>
      </LegalRow>
      <LegalRow>
        <LegalCell head>Website statistics</LegalCell>
        <LegalCell label="Details" span={3}>See <a href={`#${S.stats.id}`} class="prose-link">{S.stats.label}</a> below.</LegalCell>
      </LegalRow>
      <LegalRow>
        <LegalCell head>Saved on your device</LegalCell>
        <LegalCell label="Details" span={3}>See <a href={`#${S.device.id}`} class="prose-link">{S.device.label}</a> below.</LegalCell>
      </LegalRow>
      {jobsLive ? (
        <LegalRow>
          <LegalCell head>Job applications</LegalCell>
          <LegalCell label="Details">What you send us on WhatsApp when you apply.</LegalCell>
          <LegalCell label="Why">Only to assess your application.</LegalCell>
          <LegalCell label="Legal basis">You send it to us to apply.<LawRef>DPDP Act s.7(a)</LawRef></LegalCell>
        </LegalRow>
      ) : null}
    </LegalTable>
    <div class="prose">
      <p>
        We don't ask for passwords, card or bank details, or any health information about you. There is no account to
        create, and no payment is taken on this website.
      </p>
    </div>
  </LegalSection>

  {/* PP-4 · How we use your data — the YES rule (CONSENT_TEXT items 2–3 verbatim) */}
  <LegalSection entry={S.use}>
    <div class="prose">
      {useParas.map((c) => <p><strong>{c.title}.</strong> {c.body}</p>)}
      <p>
        Featuring your pet's photos also needs your YES on WhatsApp. You can withdraw any YES at any time; it does not
        affect what we did before you withdrew it. If we ever want to use your data for a purpose not listed here, we
        will ask you first.
      </p>
    </div>
  </LegalSection>

  {/* PP-5 · Who else handles your data (PROCESSORS + CROSS_BORDER_NOTE) */}
  <LegalSection entry={S.share}>
    <LegalTable caption="The services that handle your data for us" columns={['Service', 'What for', 'Which data']} widths={[26, 33, 41]}>
      {PROCESSORS.map((p) => (
        <LegalRow>
          <LegalCell head>{p.name}</LegalCell>
          <LegalCell label="What for">{p.purpose}</LegalCell>
          <LegalCell label="Which data">{p.data}</LegalCell>
        </LegalRow>
      ))}
    </LegalTable>
    <div class="prose">
      <p>{CROSS_BORDER_NOTE}</p>
      <p>
        We share data only with these services, to run your booking, or when the law requires it. We never sell it, and
        we never share it for advertising.
      </p>
      <p>Backup emails from {backup.name} arrive in our inbox ({site.email}).</p>
    </div>
  </LegalSection>

  {/* PP-6 · Cookies and data saved on your device (STORAGE_KEYS + NOT_USED) */}
  <LegalSection entry={S.device}>
    <div class="prose">
      <p>
        We set no advertising cookies. Google Analytics sets {cookieCount}, on the live website only. Everything else
        below is saved in your own browser by this website, mostly by the booking form; your booking details reach us
        only when you send a booking or a waitlist request. You can delete all of it in your browser settings.
      </p>
    </div>
    <LegalTable caption="Cookies and data saved on your device" columns={['Name', 'Where', 'What for', 'How long']} widths={[24, 17, 33, 26]}>
      {STORAGE_KEYS.map((k) => (
        <LegalRow>
          <LegalCell head><code class="legal-key">{k.key}</code></LegalCell>
          <LegalCell label="Where">{WHERE[k.store]}</LegalCell>
          <LegalCell label="What for">{k.purpose}</LegalCell>
          <LegalCell label="How long">{k.lifetime}</LegalCell>
        </LegalRow>
      ))}
    </LegalTable>
    {idKey ? (
      <p class="m-0 text-sm text-slate">In <code class="legal-key">{idKey}</code>, &lt;id&gt; stands for our Google Analytics measurement ID.</p>
    ) : null}
    <div class="prose mt-8">
      <h3>We don't use</h3>
      <ul>{NOT_USED.map((n) => <li>{n}</li>)}</ul>
    </div>
  </LegalSection>

  {/* PP-7 · Website statistics (CONSENT_TEXT item 1 verbatim + the GA4_SETTINGS list) */}
  <LegalSection entry={S.stats}>
    <div class="prose">
      <p><strong>{analytics.title}.</strong> {analytics.body}</p>
      <ul>
        <li>It runs on the live website only.</li>
        <li>Google Signals is switched off.</li>
        <li>There is no Google Ads link, no remarketing and no audience export.</li>
        <li>There are no heatmaps or session recordings.</li>
        <li>Detailed visit and event data is kept for {GA4_SETTINGS.dataRetentionMonths} months.</li>
        <li>IP addresses are not logged or stored.</li>
        <li>
          Area names you type are sent with every digit removed and cut to {GA4_SETTINGS.areaText.maxLength} characters,
          so a phone or house number never reaches Google Analytics.
        </li>
        <li>
          Events never carry your name or mobile number. The events we count are{' '}
          {GA4_EVENTS.map((e, i) => <>{i ? (i === GA4_EVENTS.length - 1 ? ' and ' : ', ') : ''}<code class="legal-key">{e}</code></>)}, and the
          details we add to them are{' '}
          {GA4_PARAMS.map((p, i) => <>{i ? (i === GA4_PARAMS.length - 1 ? ' and ' : ', ') : ''}<code class="legal-key">{p}</code></>)}.
        </li>
      </ul>
    </div>
  </LegalSection>

  {/* PP-8 · How long we keep your data (RETENTION) */}
  <LegalSection entry={S.keep}>
    <div class="prose">
      <ul>{RETENTION.map((r) => <li><strong>{r.what}:</strong> {r.period}</li>)}</ul>
      <p>After that we delete it, unless the law requires us to keep it longer.</p>
    </div>
  </LegalSection>

  {/* PP-9 · How we protect your data */}
  <LegalSection entry={S.protect}>
    <div class="prose">
      <p>
        Every page of this website is served over a secure HTTPS connection. Booking records are kept in a private
        Google Sheet that only our team can open, and the web address our booking form sends them to is kept secret. We
        take no card or bank details online. If a data breach affects you, we will tell you and the {LAW.BOARD} as the
        law requires.
      </p>
    </div>
  </LegalSection>

  {/* PP-10 · Your rights (RIGHTS: text + law in small slate text) */}
  <LegalSection entry={S.rights}>
    <div class="prose">
      <ul>{RIGHTS.map((r) => <li>{r.text}<LawRef>{r.law}</LawRef></li>)}</ul>
      <p>
        To use any of these rights, WhatsApp us on <ContactLink kind="whatsapp" page={PATH} /> or email{' '}
        <ContactLink kind="email" page={PATH} />. For a complaint, contact our{' '}
        <a href={`#${S.grievance.id}`}>{S.grievance.label}</a> below.
      </p>
    </div>
  </LegalSection>

  {/* PP-11 · Grievance Officer (card) */}
  <LegalSection entry={S.grievance}>
    <div class="rounded-lg border border-line bg-mint p-4 md:p-6">
      <dl class="m-0 grid gap-x-6 md:grid-cols-[auto_1fr] md:items-center">
        <dt class="text-sm font-semibold text-slate md:text-base md:text-ink">Name</dt>
        <dd class="m-0 mb-3 md:mb-0 md:py-2.5">{IDENTITY.GRIEVANCE_OFFICER_NAME}</dd>
        <dt class="text-sm font-semibold text-slate md:text-base md:text-ink">Email</dt>
        <dd class="m-0"><ContactLink kind="email" page={PATH} value={IDENTITY.GRIEVANCE_EMAIL} block /></dd>
        <dt class="text-sm font-semibold text-slate md:text-base md:text-ink">Phone</dt>
        <dd class="m-0"><ContactLink kind="phone" page={PATH} value={IDENTITY.GRIEVANCE_PHONE} block /></dd>
      </dl>
      <p class="m-0 mt-4 max-w-[65ch] border-t border-line pt-4">
        Our Grievance Officer replies to every complaint {LAW.GRIEVANCE_REPLY}. If the reply does not resolve your
        complaint, you can complain to the {LAW.BOARD}:{' '}
        {isUrl(dpbLink) ? <a href={dpbLink} target="_blank" rel="noopener">{dpbLink}</a> : dpbLink}.
      </p>
    </div>
  </LegalSection>

  {/* PP-12 · Children */}
  <LegalSection entry={S.children}>
    <div class="prose">
      <p>
        You must be {IDENTITY.MIN_AGE} or older to book with us. If you are younger, please ask a parent or guardian to
        book for you. We do not knowingly collect personal data from children.
      </p>
    </div>
  </LegalSection>

  {/* PP-13 · Changes to this policy */}
  <LegalSection entry={S.changes}>
    <div class="prose">
      <p>
        When we change this policy, we update the effective date at the top of this page. A new purpose for your data
        always needs your YES first (see <a href={`#${S.use.id}`}>{S.use.label}</a>).
      </p>
    </div>
  </LegalSection>

  {/* PP-14 · Contact us (no CTA band: legal page) */}
  <LegalSection entry={S.contact}>
    <ul class="m-0 list-none space-y-1 p-0">
      <li class="flex flex-wrap items-center gap-x-3">
        <span class="flex w-28 items-center gap-2 font-semibold"><span class="text-brand"><BrandIcon name="whatsapp" size={20} /></span>WhatsApp</span>
        <ContactLink kind="whatsapp" page={PATH} block />
      </li>
      <li class="flex flex-wrap items-center gap-x-3">
        <span class="flex w-28 items-center gap-2 font-semibold"><span class="text-brand"><Icon name="mail" size={20} /></span>Email</span>
        <ContactLink kind="email" page={PATH} block />
      </li>
      <li class="flex flex-wrap items-center gap-x-3">
        <span class="flex w-28 items-center gap-2 font-semibold"><span class="text-brand"><Icon name="phone" size={20} /></span>Phone</span>
        <ContactLink kind="phone" page={PATH} block />
      </li>
    </ul>
    <div class="prose"><p>{R3}</p></div>
  </LegalSection>
</LegalPage>

<style>
  /* Storage keys, event and parameter names: our body face (08 §2.1 allows no third family), set apart as code. */
  .legal-key {
    font-family: inherit; font-size: 0.9em; padding: 0 4px; border-radius: var(--radius-sm);
    background: var(--color-mint); color: var(--color-brand-deep); overflow-wrap: anywhere;
  }
</style>
